# Copy to .env (same directory as docker-compose.yml) and fill in:
#   cp .env.example .env

# Required — token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Required — Atlas connection string (URL-encode special chars in the password)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional
MONGODB_DB=benzabot
GITHUB_REPO_URL=https://github.com/paluigi/benzabot-docker
LOG_LEVEL=INFO
# Daily ingest time (Europe/Rome) and random jitter window in seconds
INGEST_TIME=08:30
INGEST_JITTER_SECONDS=900
